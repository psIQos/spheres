<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingTop="16dp"
            android:paddingEnd="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_horizontal"
                android:minWidth="72dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/limit_value"
                    style="@style/HudValue" />

                <TextView
                    android:id="@+id/limit_label"
                    style="@style/HudLabel" />
            </LinearLayout>

            <TextView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/back"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center_horizontal"
                android:minWidth="72dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/score_value"
                    style="@style/HudValue" />

                <TextView
                    style="@style/HudLabel"
                    android:text="@string/label_score" />
            </LinearLayout>
        </RelativeLayout>

        <com.psiqos.spheres.game.GameView
            android:id="@+id/game_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/game_over"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:visibility="gone">

        <TextView
            style="@style/HudLabel"
            android:text="@string/game_over" />

        <TextView
            android:id="@+id/final_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/text_primary"
            android:textSize="96sp" />

        <TextView
            android:id="@+id/new_best"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/new_best"
            android:textColor="#FFEC5B57"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/final_best"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="40dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/play_again"
            style="@style/ModeButton"
            android:background="@drawable/btn_green"
            android:text="@string/play_again" />

        <TextView
            android:id="@+id/to_menu"
            style="@style/ModeButton"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_grey"
            android:text="@string/menu"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</FrameLayout>
